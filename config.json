{
  "_doc": "Scanner settings. Volumes are USD for Polymarket and contracts (each pays $1) for Kalshi. Probabilities are 0-1.",
  "sources": {
    "polymarket": {
      "enabled": true,
      "max_events": 1500,
      "tag_slugs": [
        "stocks",
        "business",
        "earnings",
        "tech",
        "finance",
        "economy",
        "ipos",
        "big-tech",
        "ai",
        "companies"
      ],
      "max_events_per_tag": 300
    },
    "kalshi": {
      "enabled": true,
      "series_categories": [],
      "max_series": 400,
      "max_pages": 200,
      "skip_categories": [
        "Sports",
        "Elections",
        "Entertainment",
        "Climate and Weather",
        "Mentions"
      ],
      "skip_series_prefixes": [
        "KXMVE"
      ],
      "max_history_calls": 150,
      "taker_fee_rate": 0.07,
      "_doc": "Kalshi: page every open event (200 per page) and skip categories that never map to stocks. series_categories, if set, fetches per series instead (slow: thousands of series)."
    },
    "stocks": {
      "benchmark": "SPY",
      "history_range": "6mo",
      "request_pause_seconds": 0.35
    }
  },
  "filters": {
    "min_volume_any": 2000,
    "min_volume_event": 20000,
    "min_volume_price": 5000,
    "min_confidence": 0.25,
    "min_volume_unlinked_mover": 250000,
    "min_move_unlinked_mover": 0.1
  },
  "preferences": {
    "_doc": "Ranking preferences. Final score = base score x horizon weight x theme boost. Horizon weight interpolates [days to resolution, weight] pairs, so short-dated trades rank lower. A trade with a very large delta (price edge >= large_delta.price_edge, or an unpriced stock move >= large_delta.unpriced_move) keeps full weight even if short-dated.",
    "horizon_weights": [
      [
        0,
        0.35
      ],
      [
        7,
        0.45
      ],
      [
        30,
        0.7
      ],
      [
        90,
        1.0
      ],
      [
        180,
        1.1
      ],
      [
        365,
        1.15
      ]
    ],
    "large_delta": {
      "price_edge": 0.2,
      "unpriced_move": 0.05
    },
    "theme_boost": 1.35
  },
  "price_signal": {
    "min_edge": 0.06,
    "edge_unit": 0.05,
    "vol_blend_short_weight": 0.5,
    "vol_multiplier": 1.0,
    "min_trading_days": 0.25,
    "max_trading_days": 400,
    "skip_market_prob_outside": [
      0.02,
      0.98
    ]
  },
  "event_signal": {
    "windows": [
      7,
      30
    ],
    "min_prob_change": {
      "7": 0.05,
      "30": 0.08
    },
    "gap_unit": 0.01,
    "max_expected_move": 0.25,
    "unknown_direction_weight": 0.5
  },
  "ranking": {
    "min_score": 0.8,
    "max_opportunities": 25,
    "max_watchlist": 120
  },
  "impact_defaults": {
    "_doc": "Assumed % stock move if the event fully resolves YES, by category. The weekly analyst can override per market in analysis/notes.json.",
    "earnings": 0.04,
    "mna_target": 0.18,
    "mna": 0.04,
    "regulatory": 0.05,
    "legal": 0.04,
    "product": 0.025,
    "leadership": 0.05,
    "corporate_action": 0.03,
    "bankruptcy": 0.4,
    "index_inclusion": 0.05,
    "macro_policy": 0.03,
    "other": 0.03
  }
}
